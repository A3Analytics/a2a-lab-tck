{
  "$defs": {
    "CaptureGroupId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "DecisionHistoryPolicy": {
      "description": "How decision history is reduced before semantic ranking completes.",
      "oneOf": [
        {
          "const": "latest_authorized_production",
          "description": "Latest authorized Jev production decision per predicate and subject.",
          "type": "string"
        },
        {
          "const": "latest_per_predicate_subject",
          "description": "Latest record per predicate and subject across all producers.",
          "type": "string"
        },
        {
          "const": "full_history",
          "description": "All matching history rows; may truncate when candidate budget is exhausted.",
          "type": "string"
        }
      ]
    },
    "DecisionOutcome": {
      "description": "Lab frame decision outcome.",
      "oneOf": [
        {
          "const": "present",
          "description": "Predicate observed present.",
          "type": "string"
        },
        {
          "const": "absent",
          "description": "Predicate observed absent.",
          "type": "string"
        },
        {
          "const": "unknown",
          "description": "Observable evidence insufficient for present/absent.",
          "type": "string"
        }
      ]
    },
    "DecisionSearchFilter": {
      "description": "Filters retrieval candidates using persisted Jev decisions only.",
      "properties": {
        "history_policy": {
          "$ref": "#/$defs/DecisionHistoryPolicy",
          "default": "latest_authorized_production"
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/DecisionOutcome"
            },
            {
              "type": "null"
            }
          ]
        },
        "predicate": {
          "$ref": "#/$defs/LabPredicate"
        },
        "producer": {
          "$ref": "#/$defs/JevProducerIdentity"
        },
        "subject": {
          "anyOf": [
            {
              "$ref": "#/$defs/DecisionSubject"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "predicate",
        "producer"
      ],
      "type": "object"
    },
    "DecisionSubject": {
      "description": "Predicate subject required for evaluation and filtering.",
      "oneOf": [
        {
          "$ref": "#/$defs/PipetteChannelSubject",
          "description": "Pipetter channel for tip attachment.",
          "properties": {
            "kind": {
              "const": "pipette_channel",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/ForeignObjectSubject",
          "description": "Deck region for foreign object evidence.",
          "properties": {
            "kind": {
              "const": "foreign_object",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/PlateSlotSubject",
          "description": "Plate and deck slot for misalignment.",
          "properties": {
            "kind": {
              "const": "plate_slot",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "DecisionUnknownReason": {
      "description": "Why a predicate could not be resolved to present or absent.",
      "oneOf": [
        {
          "const": "occlusion",
          "description": "Target occluded from view.",
          "type": "string"
        },
        {
          "const": "out_of_view",
          "description": "Subject outside the observable region.",
          "type": "string"
        },
        {
          "const": "missing_reference",
          "description": "Required alignment or scene reference missing.",
          "type": "string"
        },
        {
          "const": "unavailable_calibration",
          "description": "Pose/alignment calibration unavailable.",
          "type": "string"
        },
        {
          "const": "uncertain_expectation",
          "description": "Configured expectation too uncertain to decide.",
          "type": "string"
        },
        {
          "const": "indeterminate_evidence",
          "description": "Evidence quality prevents a defensible call.",
          "type": "string"
        }
      ]
    },
    "DvrStoreNamespace": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "DvrTrackId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "EmbeddingMetric": {
      "description": "Similarity metric for a vector index space.",
      "oneOf": [
        {
          "const": "cosine",
          "description": "Cosine similarity.",
          "type": "string"
        },
        {
          "const": "dot",
          "description": "Inner product on normalized vectors.",
          "type": "string"
        },
        {
          "const": "euclidean",
          "description": "Euclidean distance.",
          "type": "string"
        }
      ]
    },
    "ForeignObjectSubject": {
      "description": "Bench/deck region for foreign-object inspection.",
      "properties": {
        "deck_region": {
          "type": "string"
        },
        "evidence_roi": {
          "$ref": "#/$defs/FrameRoiTransform"
        },
        "expected_scene_digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "unknown_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/DecisionUnknownReason"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "deck_region",
        "evidence_roi"
      ],
      "type": "object"
    },
    "FrameRoiTransform": {
      "description": "Normalized ROI `[x_min, y_min, x_max, y_max]` on the oriented saved frame.",
      "properties": {
        "bounds": {
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        }
      },
      "required": [
        "bounds"
      ],
      "type": "object"
    },
    "JevProducerIdentity": {
      "description": "Authorized TypeSafe Jev producer identity.",
      "properties": {
        "model_revision": {
          "type": "string"
        },
        "producer_id": {
          "type": "string"
        }
      },
      "required": [
        "producer_id",
        "model_revision"
      ],
      "type": "object"
    },
    "LabPredicate": {
      "description": "Supported lab predicate identifier and version.",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "type": "object"
    },
    "ModelSpaceIdentity": {
      "description": "Identity of one compatible text-embedding index namespace.",
      "properties": {
        "dimensions": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "generation": {
          "$ref": "#/$defs/ProvenanceGeneration"
        },
        "metric": {
          "$ref": "#/$defs/EmbeddingMetric"
        },
        "model": {
          "type": "string"
        },
        "normalization": {
          "$ref": "#/$defs/VectorNormalization"
        },
        "provider": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model",
        "dimensions",
        "normalization",
        "metric",
        "generation"
      ],
      "type": "object"
    },
    "PageRequest": {
      "description": "A page request using an opaque cursor.",
      "properties": {
        "cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "default": 100,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "PipetteChannelSubject": {
      "description": "Pipetter channel within a mount.",
      "properties": {
        "channel": {
          "type": "string"
        },
        "pipetter_id": {
          "type": "string"
        },
        "tip_evidence_roi": {
          "anyOf": [
            {
              "$ref": "#/$defs/FrameRoiTransform"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "pipetter_id",
        "channel"
      ],
      "type": "object"
    },
    "PlateAlignmentReference": {
      "description": "Alignment reference for plate misalignment assessment.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Expected pose digest from operator configuration.",
          "properties": {
            "expected_pose_digest": {
              "$ref": "#/$defs/Sha256Digest"
            }
          },
          "required": [
            "expected_pose_digest"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Recorded reason when no reference is available.",
          "properties": {
            "unknown": {
              "$ref": "#/$defs/DecisionUnknownReason"
            }
          },
          "required": [
            "unknown"
          ],
          "type": "object"
        }
      ]
    },
    "PlateSlotSubject": {
      "description": "Plate deck-slot subject for misalignment predicates.",
      "properties": {
        "alignment_reference": {
          "$ref": "#/$defs/PlateAlignmentReference"
        },
        "deck_slot": {
          "type": "string"
        },
        "inspection_roi": {
          "anyOf": [
            {
              "$ref": "#/$defs/FrameRoiTransform"
            },
            {
              "type": "null"
            }
          ]
        },
        "plate_id": {
          "type": "string"
        }
      },
      "required": [
        "plate_id",
        "deck_slot",
        "alignment_reference"
      ],
      "type": "object"
    },
    "ProvenanceGeneration": {
      "description": "Non-zero provenance generation for description or embedding pipelines.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "SavedFrameId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "SavedFrameRef": {
      "description": "Reference to one committed saved media revision.\n\nThe [`SavedFrameRef::frame_id`] binds store identity, source, track epoch,\noriginal capture instant, and payload bytes. Payload replacement at the same\nDVR key produces a different revision and cannot inherit prior decisions.",
      "properties": {
        "capture_group": {
          "anyOf": [
            {
              "$ref": "#/$defs/CaptureGroupId"
            },
            {
              "type": "null"
            }
          ]
        },
        "captured_at": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "frame_id": {
          "$ref": "#/$defs/SavedFrameId"
        },
        "payload_digest": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "source_id": {
          "$ref": "#/$defs/VideoSourceId"
        },
        "store": {
          "$ref": "#/$defs/DvrStoreNamespace"
        },
        "track_id": {
          "$ref": "#/$defs/DvrTrackId"
        }
      },
      "required": [
        "frame_id",
        "store",
        "source_id",
        "track_id",
        "captured_at",
        "payload_digest"
      ],
      "type": "object"
    },
    "SemanticProvenanceSelector": {
      "description": "Declares the embedding index namespace and description generation for search.",
      "properties": {
        "description_generation": {
          "$ref": "#/$defs/ProvenanceGeneration"
        },
        "model_space": {
          "$ref": "#/$defs/ModelSpaceIdentity"
        }
      },
      "required": [
        "model_space",
        "description_generation"
      ],
      "type": "object"
    },
    "SemanticSearchLimits": {
      "description": "Bounded search budgets carried on requests.",
      "properties": {
        "candidate_limit": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "max_assessment_rows_per_hit": {
          "default": 20,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "max_neighbor_frames": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "top_k": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "top_k",
        "candidate_limit",
        "max_neighbor_frames"
      ],
      "type": "object"
    },
    "SemanticSearchQuery": {
      "description": "Exactly one retrieval query: nonblank text or a saved reference revision.",
      "oneOf": [
        {
          "description": "Encodes query text in the configured text-embedding space.",
          "properties": {
            "kind": {
              "const": "text",
              "type": "string"
            },
            "text": {
              "description": "Nonblank natural-language query.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text"
          ],
          "type": "object"
        },
        {
          "description": "Reuses the reference frame's indexed description and vector.",
          "properties": {
            "frame": {
              "$ref": "#/$defs/SavedFrameRef",
              "description": "Indexed saved revision. No secondary image encoder is implied."
            },
            "kind": {
              "const": "reference_frame",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "frame"
          ],
          "type": "object"
        }
      ]
    },
    "SemanticSearchScope": {
      "description": "Finite retained source scope with an optional half-open UTC candidate filter.",
      "properties": {
        "range": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_id": {
          "$ref": "#/$defs/VideoSourceId"
        }
      },
      "required": [
        "source_id"
      ],
      "type": "object"
    },
    "Sha256Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "TimeRange": {
      "description": "A half-open UTC interval `[start, end)`.",
      "properties": {
        "end": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "start": {
          "$ref": "#/$defs/UtcTimestamp"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    },
    "UtcTimestamp": {
      "format": "date-time",
      "type": "string"
    },
    "VectorNormalization": {
      "description": "Vector normalization applied before indexing.",
      "oneOf": [
        {
          "const": "none",
          "description": "Values are stored without normalization.",
          "type": "string"
        },
        {
          "const": "l2_unit",
          "description": "L2 unit normalization.",
          "type": "string"
        }
      ]
    },
    "VideoSourceId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    }
  },
  "$id": "https://a2a-lab.dev/schemas/search-semantic-frames-request-1.0.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Search saved frames by text or reference frame within a finite scope.",
  "properties": {
    "decision_filter": {
      "anyOf": [
        {
          "$ref": "#/$defs/DecisionSearchFilter"
        },
        {
          "type": "null"
        }
      ]
    },
    "limits": {
      "$ref": "#/$defs/SemanticSearchLimits"
    },
    "page": {
      "$ref": "#/$defs/PageRequest"
    },
    "provenance": {
      "$ref": "#/$defs/SemanticProvenanceSelector"
    },
    "query": {
      "$ref": "#/$defs/SemanticSearchQuery"
    },
    "scope": {
      "$ref": "#/$defs/SemanticSearchScope"
    }
  },
  "required": [
    "scope",
    "query",
    "provenance",
    "limits",
    "page"
  ],
  "title": "SearchSemanticFramesRequest",
  "type": "object"
}
