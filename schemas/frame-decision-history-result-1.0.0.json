{
  "$defs": {
    "CaptureGroupId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "DecisionEvaluationCoverage": {
      "description": "Evaluation job coverage distinct from decision outcomes.",
      "oneOf": [
        {
          "const": "evaluated",
          "description": "Jev produced a decision outcome.",
          "type": "string"
        },
        {
          "const": "not_evaluated",
          "description": "Job never ran.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "Request failed before a decision.",
          "type": "string"
        },
        {
          "const": "timed_out",
          "description": "Job exceeded its deadline.",
          "type": "string"
        },
        {
          "const": "cancelled",
          "description": "Operator or runner cancelled the job.",
          "type": "string"
        },
        {
          "const": "unsupported",
          "description": "Predicate unsupported for the evidence.",
          "type": "string"
        }
      ]
    },
    "DecisionEvidenceAvailability": {
      "description": "Evidence availability reported without mutating stored outcomes.",
      "oneOf": [
        {
          "const": "ready",
          "description": "Evidence bytes remain resolvable for this item.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "Evidence is missing or unavailable; the decision outcome is unchanged.",
          "properties": {
            "unavailable": {
              "properties": {
                "reason": {
                  "description": "Stable explanation for operators.",
                  "type": "string"
                }
              },
              "required": [
                "reason"
              ],
              "type": "object"
            }
          },
          "required": [
            "unavailable"
          ],
          "type": "object"
        }
      ]
    },
    "DecisionEvidenceItem": {
      "description": "One bounded evidence item for a frame decision.",
      "properties": {
        "frame_id": {
          "$ref": "#/$defs/SavedFrameId"
        },
        "kind": {
          "$ref": "#/$defs/DecisionEvidenceKind"
        },
        "reference_digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "roi": {
          "$ref": "#/$defs/FrameRoiTransform"
        }
      },
      "required": [
        "frame_id",
        "roi",
        "kind"
      ],
      "type": "object"
    },
    "DecisionEvidenceKind": {
      "description": "Modality of image evidence supplied to Jev.",
      "oneOf": [
        {
          "const": "saved_frame_revision",
          "description": "Exact saved frame revision bytes.",
          "type": "string"
        },
        {
          "const": "reference_image",
          "description": "Operator reference still image digest.",
          "type": "string"
        }
      ]
    },
    "DecisionHistoryPolicy": {
      "description": "How decision history is reduced before semantic ranking completes.",
      "oneOf": [
        {
          "const": "latest_authorized_production",
          "description": "Latest authorized Jev production decision per predicate and subject.",
          "type": "string"
        },
        {
          "const": "latest_per_predicate_subject",
          "description": "Latest record per predicate and subject across all producers.",
          "type": "string"
        },
        {
          "const": "full_history",
          "description": "All matching history rows; may truncate when candidate budget is exhausted.",
          "type": "string"
        }
      ]
    },
    "DecisionIdempotencyKey": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "DecisionOutcome": {
      "description": "Lab frame decision outcome.",
      "oneOf": [
        {
          "const": "present",
          "description": "Predicate observed present.",
          "type": "string"
        },
        {
          "const": "absent",
          "description": "Predicate observed absent.",
          "type": "string"
        },
        {
          "const": "unknown",
          "description": "Observable evidence insufficient for present/absent.",
          "type": "string"
        }
      ]
    },
    "DecisionSubject": {
      "description": "Predicate subject required for evaluation and filtering.",
      "oneOf": [
        {
          "$ref": "#/$defs/PipetteChannelSubject",
          "description": "Pipetter channel for tip attachment.",
          "properties": {
            "kind": {
              "const": "pipette_channel",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/ForeignObjectSubject",
          "description": "Deck region for foreign object evidence.",
          "properties": {
            "kind": {
              "const": "foreign_object",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/PlateSlotSubject",
          "description": "Plate and deck slot for misalignment.",
          "properties": {
            "kind": {
              "const": "plate_slot",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "DecisionUnknownReason": {
      "description": "Why a predicate could not be resolved to present or absent.",
      "oneOf": [
        {
          "const": "occlusion",
          "description": "Target occluded from view.",
          "type": "string"
        },
        {
          "const": "out_of_view",
          "description": "Subject outside the observable region.",
          "type": "string"
        },
        {
          "const": "missing_reference",
          "description": "Required alignment or scene reference missing.",
          "type": "string"
        },
        {
          "const": "unavailable_calibration",
          "description": "Pose/alignment calibration unavailable.",
          "type": "string"
        },
        {
          "const": "uncertain_expectation",
          "description": "Configured expectation too uncertain to decide.",
          "type": "string"
        },
        {
          "const": "indeterminate_evidence",
          "description": "Evidence quality prevents a defensible call.",
          "type": "string"
        }
      ]
    },
    "DvrStoreNamespace": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "DvrTrackId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "ForeignObjectSubject": {
      "description": "Bench/deck region for foreign-object inspection.",
      "properties": {
        "deck_region": {
          "type": "string"
        },
        "evidence_roi": {
          "$ref": "#/$defs/FrameRoiTransform"
        },
        "expected_scene_digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "unknown_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/DecisionUnknownReason"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "deck_region",
        "evidence_roi"
      ],
      "type": "object"
    },
    "FrameDecisionHistoryEntry": {
      "description": "One history row plus per-evidence availability.",
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/DecisionEvidenceAvailability"
          },
          "type": "array"
        },
        "record": {
          "$ref": "#/$defs/FrameDecisionRecord"
        }
      },
      "required": [
        "record",
        "evidence"
      ],
      "type": "object"
    },
    "FrameDecisionId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "FrameDecisionReadScope": {
      "description": "Half-open source/time scope with an optional exact frame revision pin.",
      "properties": {
        "frame": {
          "anyOf": [
            {
              "$ref": "#/$defs/SavedFrameRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "range": {
          "$ref": "#/$defs/TimeRange"
        },
        "source_id": {
          "$ref": "#/$defs/VideoSourceId"
        }
      },
      "required": [
        "source_id",
        "range"
      ],
      "type": "object"
    },
    "FrameDecisionRecord": {
      "description": "Immutable production frame decision bound to one saved revision.",
      "properties": {
        "decision_id": {
          "$ref": "#/$defs/FrameDecisionId"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/DecisionEvidenceItem"
          },
          "type": "array"
        },
        "frame": {
          "$ref": "#/$defs/SavedFrameRef"
        },
        "idempotency_key": {
          "$ref": "#/$defs/DecisionIdempotencyKey"
        },
        "outcome": {
          "$ref": "#/$defs/DecisionOutcome"
        },
        "predicate": {
          "$ref": "#/$defs/LabPredicate"
        },
        "provenance": {
          "$ref": "#/$defs/JevEvaluationProvenance"
        },
        "structured_output": {
          "$ref": "#/$defs/JevStructuredOutput"
        },
        "subject": {
          "$ref": "#/$defs/DecisionSubject"
        },
        "supersedes": {
          "anyOf": [
            {
              "$ref": "#/$defs/FrameDecisionId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "decision_id",
        "idempotency_key",
        "frame",
        "predicate",
        "subject",
        "evidence",
        "outcome",
        "structured_output",
        "provenance"
      ],
      "type": "object"
    },
    "FrameRoiTransform": {
      "description": "Normalized ROI `[x_min, y_min, x_max, y_max]` on the oriented saved frame.",
      "properties": {
        "bounds": {
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        }
      },
      "required": [
        "bounds"
      ],
      "type": "object"
    },
    "JevEvaluationId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "JevEvaluationProvenance": {
      "description": "Capture and evaluation provenance for one Jev decision.",
      "properties": {
        "calibration_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "captured_at": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "config_digest": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "coverage": {
          "$ref": "#/$defs/DecisionEvaluationCoverage"
        },
        "criteria_digest": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "evaluated_at": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "evaluation_id": {
          "$ref": "#/$defs/JevEvaluationId"
        },
        "jev_response_digest": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "model_input_transform": {
          "$ref": "#/$defs/FrameRoiTransform"
        },
        "producer": {
          "$ref": "#/$defs/JevProducerIdentity"
        },
        "prompt_digest": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "threshold_policy_digest": {
          "$ref": "#/$defs/Sha256Digest"
        }
      },
      "required": [
        "captured_at",
        "evaluated_at",
        "producer",
        "evaluation_id",
        "config_digest",
        "prompt_digest",
        "criteria_digest",
        "threshold_policy_digest",
        "model_input_transform",
        "jev_response_digest",
        "coverage"
      ],
      "type": "object"
    },
    "JevProducerIdentity": {
      "description": "Authorized TypeSafe Jev producer identity.",
      "properties": {
        "model_revision": {
          "type": "string"
        },
        "producer_id": {
          "type": "string"
        }
      },
      "required": [
        "producer_id",
        "model_revision"
      ],
      "type": "object"
    },
    "JevStructuredOutput": {
      "description": "Structured Jev outputs persisted with the decision.",
      "properties": {
        "evidence_box": {
          "anyOf": [
            {
              "$ref": "#/$defs/FrameRoiTransform"
            },
            {
              "type": "null"
            }
          ]
        },
        "level_distribution": {
          "anyOf": [
            {
              "$ref": "#/$defs/LabProbabilityVector"
            },
            {
              "type": "null"
            }
          ]
        },
        "noul_probability": {
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "option_distribution": {
          "anyOf": [
            {
              "$ref": "#/$defs/LabProbabilityVector"
            },
            {
              "type": "null"
            }
          ]
        },
        "rubric_score": {
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "structured_value": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsonObject"
            },
            {
              "type": "null"
            }
          ]
        },
        "vendor_confidence": {
          "description": "Vendor confidence summarizing a distribution; not class probability.",
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "JsonObject": {
      "additionalProperties": true,
      "type": "object"
    },
    "LabPredicate": {
      "description": "Supported lab predicate identifier and version.",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "type": "object"
    },
    "LabProbabilityVector": {
      "description": "Normalized probability vector from Jev choice/score primitives.",
      "properties": {
        "labels": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "values": {
          "items": {
            "format": "float",
            "type": "number"
          },
          "type": "array"
        }
      },
      "required": [
        "labels",
        "values"
      ],
      "type": "object"
    },
    "Page": {
      "description": "One page of results.",
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/FrameDecisionHistoryEntry"
          },
          "type": "array"
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "items"
      ],
      "type": "object"
    },
    "PipetteChannelSubject": {
      "description": "Pipetter channel within a mount.",
      "properties": {
        "channel": {
          "type": "string"
        },
        "pipetter_id": {
          "type": "string"
        },
        "tip_evidence_roi": {
          "anyOf": [
            {
              "$ref": "#/$defs/FrameRoiTransform"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "pipetter_id",
        "channel"
      ],
      "type": "object"
    },
    "PlateAlignmentReference": {
      "description": "Alignment reference for plate misalignment assessment.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Expected pose digest from operator configuration.",
          "properties": {
            "expected_pose_digest": {
              "$ref": "#/$defs/Sha256Digest"
            }
          },
          "required": [
            "expected_pose_digest"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Recorded reason when no reference is available.",
          "properties": {
            "unknown": {
              "$ref": "#/$defs/DecisionUnknownReason"
            }
          },
          "required": [
            "unknown"
          ],
          "type": "object"
        }
      ]
    },
    "PlateSlotSubject": {
      "description": "Plate deck-slot subject for misalignment predicates.",
      "properties": {
        "alignment_reference": {
          "$ref": "#/$defs/PlateAlignmentReference"
        },
        "deck_slot": {
          "type": "string"
        },
        "inspection_roi": {
          "anyOf": [
            {
              "$ref": "#/$defs/FrameRoiTransform"
            },
            {
              "type": "null"
            }
          ]
        },
        "plate_id": {
          "type": "string"
        }
      },
      "required": [
        "plate_id",
        "deck_slot",
        "alignment_reference"
      ],
      "type": "object"
    },
    "SavedFrameId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "SavedFrameRef": {
      "description": "Reference to one committed saved media revision.\n\nThe [`SavedFrameRef::frame_id`] binds store identity, source, track epoch,\noriginal capture instant, and payload bytes. Payload replacement at the same\nDVR key produces a different revision and cannot inherit prior decisions.",
      "properties": {
        "capture_group": {
          "anyOf": [
            {
              "$ref": "#/$defs/CaptureGroupId"
            },
            {
              "type": "null"
            }
          ]
        },
        "captured_at": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "frame_id": {
          "$ref": "#/$defs/SavedFrameId"
        },
        "payload_digest": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "source_id": {
          "$ref": "#/$defs/VideoSourceId"
        },
        "store": {
          "$ref": "#/$defs/DvrStoreNamespace"
        },
        "track_id": {
          "$ref": "#/$defs/DvrTrackId"
        }
      },
      "required": [
        "frame_id",
        "store",
        "source_id",
        "track_id",
        "captured_at",
        "payload_digest"
      ],
      "type": "object"
    },
    "Sha256Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "TimeRange": {
      "description": "A half-open UTC interval `[start, end)`.",
      "properties": {
        "end": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "start": {
          "$ref": "#/$defs/UtcTimestamp"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    },
    "UtcTimestamp": {
      "format": "date-time",
      "type": "string"
    },
    "VideoSourceId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    }
  },
  "$id": "https://a2a-lab.dev/schemas/frame-decision-history-result-1.0.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One page of decision history plus filter metadata.",
  "properties": {
    "entries": {
      "$ref": "#/$defs/Page"
    },
    "history_policy": {
      "$ref": "#/$defs/DecisionHistoryPolicy"
    },
    "scope": {
      "$ref": "#/$defs/FrameDecisionReadScope"
    }
  },
  "required": [
    "scope",
    "history_policy",
    "entries"
  ],
  "title": "FrameDecisionHistoryResult",
  "type": "object"
}
